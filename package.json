{
  "name": "theo",
  "version": "2.0.9",
  "description": "Theo is your AuthorizedKeys manager",
  "main": "build/otel.js",
  "repository": "theoapp/theo-node",
  "type": "commonjs",
  "scripts": {
    "prebuild": "node scripts/version-update.mjs",
    "build": "babel src -d build",
    "build:dev": "babel --watch src --out-dir build",
    "clean": "rm -rf build",
    "env2doc": "npm run -s build && env2doc -d -p build > ENVIRONMENT.md",
    "env2doc:check": "npm run -s build && env2doc -d -p build > .env2doc-check.tmp && diff .env2doc-check.tmp ENVIRONMENT.md",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "start:dev": "nodemon --signal SIGTERM --watch .env --watch src --exec babel-node ./src/otel.js",
    "start": "node ./build/otel.js",
    "test": "mocha tests/test*.js",
    "test:api": "mocha tests/testRest*",
    "test:api:signed": "mocha tests/testSigned*",
    "test:cluster": "mocha tests/testCluster.js",
    "test:core": "mocha tests/testCore.js",
    "test:core:restart": "mocha tests/testCoreOnRestart.js",
    "test:core:noassignee": "mocha tests/testCoreNoAssignee.js",
    "test:core:restart:noassignee": "mocha tests/testCoreOnRestartNoAssignee.js",
    "test:standalone": "mocha tests/testStandAlone*.js",
    "test:upgrade:mysql": "mocha tests/testUpgrade_mysql.js",
    "test:upgrade:sqlite": "mocha tests/testUpgrade_sqlite.js",
    "test:multiinstances": "mocha tests/testMultiInstances.js",
    "preversion": "npm run -s lint && npm run -s build",
    "ver": "echo $npm_package_version"
  },
  "nodemonConfig": {
    "delay": 2000
  },
  "author": "Michele Azzolari <macno@authkeys.io> (macno)",
  "license": "Apache-2.0",
  "dependencies": {
    "@fluidware-it/express-microservice": "^0.7.0-rc.0",
    "@fluidware-it/saddlebag": "^0.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-memcached": "^0.67.0",
    "@opentelemetry/instrumentation-mysql2": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "dotenv": "^16.0.3",
    "memcached": "^2.2.2",
    "mysql2": "^3.24.6",
    "pg": "^8.8.0",
    "redis": "^4.5.1",
    "semver": "^7.5.4",
    "sqlite3": "^5.1.7",
    "sshpk": "^1.17.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/node": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "@fluidware-it/env2doc": "^0.3.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "17.15.1",
    "eslint-plugin-prettier": "^5.2.1",
    "mocha": "^11.0.1",
    "mock-http-server": "^1.4.2",
    "nodemon": "^2.0.7",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.19.1"
  }
}
